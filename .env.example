# このファイルを .env にコピーして使う（.env は Git に入れない）
# 置き場所はリポジトリ直下か backend/。バックエンド起動時に読み込む（すでにある環境変数が優先）
# 何も設定しなければ「デモ AI」「デモ検索」で動く（API キー不要・外部に通信しない）

# --- AI（demo | gemini） ---
AI_PROVIDER=demo
# Gemini API の無料枠を使う場合（Google AI Studio で発行）→ AI_PROVIDER=gemini にしてキーを入れる
# 確認：cd backend して python -m app.ai.check
# ※ 無料枠では送った内容が Google の製品改善に使われる。アプリは単元名・レベル・日付・教材情報だけを送る
GEMINI_API_KEY=
# 古いモデル（例：gemini-2.5-flash-lite）は新しいキーでは 404（no longer available to new users）になる
GEMINI_MODEL=gemini-3.1-flash-lite
# アプリ側で数える1日の上限（Google 側の無料枠の上限とは別。超えるとエラーで止める）
GEMINI_DAILY_LIMIT=500

# --- 検索（優先順にカンマ区切り：demo,tavily,qiita,youtube） ---
# demo は実在しない URL（example.com）。本物の教材にするには tavily,qiita,youtube にする
# qiita はキー不要。tavily は https://app.tavily.com 、youtube は Google Cloud の YouTube Data API v3 でキーを発行
SEARCH_PROVIDERS=demo
TAVILY_API_KEY=
TAVILY_MONTHLY_LIMIT=1000
QIITA_TOKEN=
QIITA_HOURLY_LIMIT=1000
YOUTUBE_API_KEY=
YOUTUBE_DAILY_SEARCH_LIMIT=100

# 教材 URL の実在チェック（外部に接続できる環境で true）
URL_CHECK=false

# 検索してよいドメイン（カンマ区切り。未設定なら公式ドキュメント系の既定リスト）
# ALLOWED_DOMAINS=docs.python.org,docs.aws.amazon.com,qiita.com,www.youtube.com

# デモ・動作確認用に「今日」を固定する（例：2026-12-10）
# TODAY=

# DB（未設定なら SQLite のファイル studyplan.db）
# DATABASE_URL=postgresql+psycopg://studyplan:studyplan@localhost:5432/studyplan
